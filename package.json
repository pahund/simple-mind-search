{
  "name": "simple-mind-search",
  "version": "1.3.0",
  "description": "A CLI tool to search across all your SimpleMind mind maps at once",
  "keywords": [
    "simplemind",
    "mind-map",
    "mindmap",
    "search",
    "cli",
    "productivity"
  ],
  "author": "Patrick Hund",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/pahund/simple-mind-search.git"
  },
  "bugs": {
    "url": "https://github.com/pahund/simple-mind-search/issues"
  },
  "homepage": "https://github.com/pahund/simple-mind-search#readme",
  "main": "dist/index.js",
  "bin": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".simple-mind-search.default.yml"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "ralph": "ralph/run.sh 100",
    "ralph:once": "ralph/run.sh 1",
    "clean": "rm -rf dist coverage tmp/*",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "format": "prettier --write --log-level=warn \"src/**/*.ts\"",
    "lint": "eslint src",
    "ts:check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest run --watch",
    "test:ui": "vitest run --ui",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config=vitest.integration.config.mts",
    "test:integration:watch": "vitest run --config=vitest.integration.config.mts --watch",
    "test:integration:ui": "vitest run --config=vitest.integration.config.mts --ui",
    "test:integration:coverage": "vitest run --config=vitest.integration.config.mts --coverage",
    "prepublishOnly": "yarn lint && yarn ts:check && yarn test && yarn test:integration && yarn build"
  },
  "packageManager": "yarn@4.12.0",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/adm-zip": "^0.5.7",
    "@types/debug": "^4",
    "@types/eslint__js": "^9.14.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.3",
    "@vitest/coverage-v8": "4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "commander": "^14.0.2",
    "debug": "^4.4.3",
    "fast-glob": "^3.3.3",
    "fast-xml-parser": "^5.3.3",
    "js-yaml": "^4.1.1"
  }
}
