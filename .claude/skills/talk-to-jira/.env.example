# JIRA REST API Configuration
# Copy this file to .env and fill in your actual values

# JIRA instance base URL (required)
# For Atlassian Cloud: https://your-company.atlassian.net
# For Server/Data Centre: https://jira.your-company.com
JIRA_BASE_URL=https://your-company.atlassian.net

# Authentication Method 1: API Token (Recommended for Atlassian Cloud)
# Get your API token from: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_api_token_here
JIRA_EMAIL=your.email@company.com

# Authentication Method 2: Personal Access Token (For Server/Data Centre)
# Create PAT in JIRA: Profile → Personal Access Tokens
# JIRA_PAT=your_personal_access_token_here

# Notes:
# - Use API Token + Email for Atlassian Cloud
# - Use PAT for JIRA Server or Data Centre
# - Only one authentication method is needed
# - Keep this file secure and never commit it to version control
